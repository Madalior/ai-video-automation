# ==============================================================================
# Going Merry & Clipper — Production .gitignore
# Ensures only clean production code is tracked; excludes debug dumps & tests.
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/

# IDE & OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Logs
*.log
logs/
antigravity.log

# Databases & Runtime Instances
*.db
*.sqlite3
instance/*.db
instance/*.sqlite
database.db

# Output & Cache Directories
output/
output_*/
cache/
footage_cache/
frames_cache/
test_frames_cache/
music_library/trends_cache/

# Chrome & Browser Profiles / Sessions
chrome_data*/
chrome_data_*/
chrome_profiles/
temp_chrome_profiles/
pool_profiles/
test_pool_profiles/
temp_proxy_ext/
sessions/
gmail_tokens/
youtube_tokens/

# Media & Heavy Dumps
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.tmp
*.temp
temp/
clipper/remotion/detail_*.png
clipper/remotion/ref_frame_*.png
clipper/frame_*.png
Text Animation Pack By Bh4vyafx/
vaseline_extra/

# Node & Remotion Build
node_modules/
clipper/remotion/node_modules/
genkit-service/
media-inference-worker/

# Dead Proxies & One-Off Scraper Dumps
*proxies*.txt
campaign_links_raw.json
whop_scout_results.json
channel_niche.json
video_idea_history.json
batch_config.json
studio_config.json

# Scratch Tests & Deprecated Scripts
scratch/
flowchart/
01_user_data/
02_niche_discovery/
03_ideation_scripting/
04_generation/
05_platform_auth/
06_uploading/
batch_templates/
character_cards/
submissions/
test_*.py
test_*.bat
test_*.txt
patch_*.py
whop_*.py
antigravity_optimizer*.py
*.bat

# Sensitive Configuration
.env
.env.local
secrets.json
credentials.json
client_secrets.json

# Exception: keep important production configs
!.env.example
!package.json
!package-lock.json
!requirements.txt
!yolov8n-face.pt
